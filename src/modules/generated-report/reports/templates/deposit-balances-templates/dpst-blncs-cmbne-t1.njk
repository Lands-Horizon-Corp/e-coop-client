<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Deposit Balances Per Table Report</title>
        <style>
            @page {
                margin: 0.5in;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body,
            html {
                margin: 0;
                padding: 0;
                min-height: 100%;
                background-color: white;
            }

            body {
                margin: 0;
                padding: 0;
                height: auto;
                /* Change from min-height: 100% */
                display: block;
            }

            /* BASE VARS AT TOKEN */
            .container {
                /* FONT SCALE */
                --fs-xs: 7px;
                --fs-sm: 8px;
                --fs-base: 9px;
                --fs-lg: 10px;
                --fs-xl: 12px;
                --fs-2xl: 14px;

                /* SPACING SCALE */
                --space-xs: 0.08rem;
                --space-sm: 0.15rem;
                --space-md: 0.25rem;
                --space-lg: 0.3rem;
                --space-xl: 0.4rem;

                /* LAYOUT */
                --container-padding: 0.3in;
                --line-height: 1.3;

                --sig-gap-x: 0.7rem;
                --sig-gap-y: 1.4rem;
                --sig-margin-t: 2rem;

                padding: var(--container-padding);
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
                font-size: var(--fs-base);
                line-height: var(--line-height);

                display: flex;
                flex-direction: column;
                justify-content: flex-start;
                /* FORCE content to the top */
                align-items: stretch;
                width: 100%;
            }

            /* DENSITY VARIANTS */

            /* NORMAL (default, explicit if you want) */
            .normal .container {
                --fs-xs: 7px;
                --fs-sm: 8px;
                --fs-base: 9px;
                --fs-lg: 10px;
                --fs-xl: 12px;
                --fs-2xl: 14px;

                --space-xs: 0.08rem;
                --space-sm: 0.15rem;
                --space-md: 0.25rem;
                --space-lg: 0.3rem;
                --space-xl: 0.4rem;

                --sig-gap-x: 0.7rem;
                --sig-gap-y: 1.4rem;
                --sig-margin-t: 2rem;

                --container-padding: 0.3in;
                --line-height: 1.3;
            }

            /* COMPACT */
            .compact .container {
                --fs-xs: 6px;
                --fs-sm: 7px;
                --fs-base: 8px;
                --fs-lg: 9px;
                --fs-xl: 10px;
                --fs-2xl: 12px;

                --space-xs: 0.05rem;
                --space-sm: 0.1rem;
                --space-md: 0.15rem;
                --space-lg: 0.2rem;
                --space-xl: 0.25rem;

                --sig-gap-x: 0.3rem;
                --sig-gap-y: 1rem;
                --sig-margin-t: 1.4rem;

                --container-padding: 0.15in;
                --line-height: 1.2;
            }

            /* LARGER */
            .loose .container {
                --fs-xs: 8px;
                --fs-sm: 10px;
                --fs-base: 12px;
                --fs-lg: 14px;
                --fs-xl: 16px;
                --fs-2xl: 18px;

                --space-xs: 0.1rem;
                --space-sm: 0.2rem;
                --space-md: 0.3rem;
                --space-lg: 0.4rem;
                --space-xl: 0.5rem;

                --sig-gap-x: 1.8rem;
                --sig-gap-y: 2rem;
                --sig-margin-t: 1rem;

                --container-padding: 0.4in;
                --line-height: 1.4;
            }

            /* HEADER */
            .header {
                text-align: center;
                margin-bottom: var(--space-lg);
                padding-bottom: var(--space-sm);
                /* border-bottom: 1px solid #e5e7eb; */
            }

            .header h1 {
                font-size: var(--fs-xl);
                font-weight: 800;
                margin-bottom: var(--space-xs);
                letter-spacing: -0.025em;
            }

            .header .address {
                font-size: var(--fs-base);
                margin: var(--space-xs) 0;
            }

            .header .tin {
                font-size: var(--fs-sm);
            }

            .report-title {
                font-size: var(--fs-2xl);
                font-weight: 800;
                margin-top: var(--space-sm);
                letter-spacing: -0.025em;
                text-transform: uppercase;
            }

            .center {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
            }

            /* TABLE */
            .table {
                width: 100%;
                margin-top: var(--space-xl);
                margin-bottom: var(--space-lg);
                border: 0;
                border-radius: 6px;
                overflow: hidden;
                font-size: var(--fs-base);
                border-collapse: collapse;
                box-shadow: inset 0 0 0 1px #e5e7eb;
            }

            .table th {
                text-transform: uppercase;
                font-size: var(--fs-sm);
                font-weight: 700;
                padding: var(--space-lg);
                text-align: left;
                border-bottom: 2px solid #e5e7eb;
            }

            .table td {
                padding: var(--space-md) var(--space-lg);
                border-bottom: 1px solid #f3f4f6;
            }

            .bold {
                font-weight: 900;
            }

            .text-right {
                text-align: right !important;
                font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
                font-variant-numeric: tabular-nums;
            }

            .italic {
                font-style: italic;
            }

            .page-break {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                margin: 20px 0;
                border-top: 1px dashed #ccc;
                height: 1px;
                position: relative;
            }

            .page-break::after {
                content: 'next page';
                position: absolute;
                background: #fff;
                padding: 0 10px;
                font-size: 10px;
                color: #999;
            }

            /* PRINT */
            @media print {
                body {
                    background-color: white;
                }
                * {
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }

                .container {
                    padding: 0 !important;
                    margin: 0 !important;
                }

                .page-break {
                    display: block;
                    page-break-after: always;
                    break-after: page;

                    border: none;
                    height: 0;
                    margin: 0;
                }

                .page-break::after {
                    content: '';
                }
            }
        </style>
    </head>
    <body class="{{ density | default('normal') }}">
        {% set groups = data | default([]) %}
        {% set account_cols = showable_account_column_list | default([]) %}
        {% set base_colspan = 2 + (account_cols.length or 0) %}

        {% macro account_key(col) %}account_{{ col.account_id }}_amount{% endmacro %}
        {% macro account_member_key(col) %}account_{{ col.account_id }}_total_members{% endmacro %}

        {% macro render_table_head() %}
            <thead>
                <tr>
                    <th>PB No.</th>
                    <th>Member Name</th>
                    {% for col in account_cols %}
                        <th class="text-right">
                            {{ col.short_name or col.name or col.account_id }}
                            {% if col.display_entry_type %}
                                ({{ col.display_entry_type }})
                            {% endif %}
                        </th>
                    {% endfor %}
                </tr>
            </thead>
        {% endmacro %}

        {% macro render_entry_rows(entries) %}
            {% for entry in entries %}
                <tr>
                    <td>{{ entry.passbook or '-' }}</td>
                    <td>{{ entry.member_name or '-' }}</td>
                    {% for col in account_cols %}
                        {% set key = account_key(col) %}
                        <td class="text-right">{{ entry[key] or '0.00' }}</td>
                    {% endfor %}
                </tr>
            {% endfor %}
        {% endmacro %}

        {% macro render_total_rows(total, label, is_final = false) %}
            {% set row_bg = 'background: #f8fafc;' if is_final else '' %}
            <tr>
                <td colspan="2" class="bold" style="{{ row_bg }}">{{ label }}</td>
                {% for col in account_cols %}
                    {% set key = account_key(col) %}
                    <td class="text-right bold" style="{{ row_bg }}">{{ total[key] or '0.00' }}</td>
                {% endfor %}
            </tr>
            <tr>
                <td colspan="2" class="bold" style="{{ row_bg }}">NO. OF MEMBERS</td>
                {% for col in account_cols %}
                    {% set key = account_member_key(col) %}
                    <td class="text-right bold" style="{{ row_bg }}">{{ total[key] or '0' }}</td>
                {% endfor %}
            </tr>
        {% endmacro %}

        {% macro render_group_rows(groups_to_render) %}
            {% for group in groups_to_render %}
                <tr>
                    <td colspan="{{ base_colspan }}" style="font-weight: 700;">
                        {{ group.roup_title }}: {{ group.group_name }}
                    </td>
                </tr>

                {% if report_type != 'summary' %}
                    {% if group.sub_groups and group.sub_groups.length %}
                        {{ render_group_rows(group.sub_groups) }}
                    {% endif %}

                    {% if group.data_entries and group.data_entries.length %}
                        {{ render_entry_rows(group.data_entries) }}
                    {% endif %}
                {% endif %}

                {{ render_total_rows(group.total_per, group.group_name + ' SUB TOTAL') }}

                {% if not loop.last %}
                    <tr>
                        <td colspan="{{ base_colspan }}" style="border: 0; padding: 10px;"></td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% endmacro %}

        <div class="container">
            <header class="header">
                <h1>{{ header_title }}</h1>
                <p class="address">{{ header_address }}</p>
                <p class="tin">TIN: {{ tax_number }}</p>
            </header>

            <div class="center">
                <h2 class="report-title">
                    {{ report_title or 'DEPOSIT BALANCES REPORT' }}
                </h2>
                <div class="tin">FROM: {{ start_date }} TO: {{ end_date }}</div>
                <div class="tin">{{ grouping }}</div>
            </div>

            <table class="table">
                {{ render_table_head() }}
                <tbody>
                    {{ render_group_rows(groups) }}
                    <tr>
                        <td colspan="{{ base_colspan }}" style="border: 0; padding: 2px;">&nbsp;</td>
                    </tr>
                    {{ render_total_rows(grand_total, 'GRAND TOTAL', true) }}
                </tbody>
            </table>
        </div>
    </body>
</html>
